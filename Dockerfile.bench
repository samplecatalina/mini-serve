# The load generator, in an image of its own.
#
# It is deliberately not the development image. The client that measures
# mini-serve must be the same client that measures the engines it is compared
# against, and keeping it outside the engine's image makes that a property of
# the setup rather than a claim in a checklist. It also keeps the engine image
# byte-identical to the one whose correctness was verified on the cluster:
# genai-bench pulls in thirty-odd packages that have no business sitting next
# to a pinned torch.
#
# Nothing here touches the GPU. nvidia-smi is read (through --gpus all, or
# apptainer --nv) only to record the conditions a run happened under.
#
#   docker build -f Dockerfile.bench -t miniserve-bench:latest .

FROM python:3.12-slim

# genai-bench is pinned: the benchmark caliber is part of the measurement, and
# a resolver that quietly moves it would move the numbers with it.
ARG GENAI_BENCH_VERSION=0.0.5
RUN pip install --no-cache-dir "genai-bench==${GENAI_BENCH_VERSION}" httpx \
    && pip freeze > /opt/bench-requirements.txt \
    && python -c "import genai_bench, pathlib; pathlib.Path('/opt/bench-version').write_text(genai_bench.__version__ if hasattr(genai_bench,'__version__') else '${GENAI_BENCH_VERSION}')"

# The tokenizer must match the one the server uses; it is read from the mounted
# cache, not downloaded, so a run needs no network.
# The container runs as the invoking user, who has no home directory in it.
ENV HF_HOME=/cache/huggingface \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace

WORKDIR /workspace
